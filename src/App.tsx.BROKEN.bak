{formatOnlineIso(v.deployedAtIso)}                    </div>
                  </div>

                  <ul style={{ margin: "10px 0 0 18px", padding: 0, opacity: 0.9, fontSize: 13 }}>
                    {v.notes.map((n, i) => (
