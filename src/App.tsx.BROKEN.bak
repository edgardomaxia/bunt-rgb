    }}
  >
    PRACTICE
  </div>
) : null}

      {/* VERSION MODAL */}
      {isVersionOpen ? (
        <div
          onClick={() => setIsVersionOpen(false)}
          style={{
            position: "fixed",
            inset: 0,
            background: "rgba(0,0,0,.6)",
            display: "flex",
