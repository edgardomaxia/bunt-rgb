      >
        <div style={{ textAlign: "center", width: "100%" }}>
          {/* TOP CENTER: version + status + links */}
<div style={{ display: "flex", flexDirection: "column", alignItems: "center", gap: 10, marginTop: 6 }}>
  <div
    style={{
      display: "flex",
      alignItems: "center",
      gap: 6,
      fontSize: 11,
      opacity: 0.75,
    }}
  >
    <div
      role="button"
      tabIndex={0}
